{
  "name": "toolbox",
  "productName": "ToolBox",
  "version": "0.25.0",
  "description": "Hub d'outils personnel : application de bureau Windows modulaire.",
  "author": "Thomas",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "build/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "lint": "eslint . && prettier --check . && npm run check:ui-colors && npm run check:ui-emoji",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "vitest run --mode full",
    "test:watch": "vitest",
    "check:native": "node scripts/check-native.mjs",
    "check:ui-colors": "node scripts/check-ui-colors.mjs",
    "check:ui-emoji": "node scripts/check-ui-emoji.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@fastify/static": "^10.1.8",
    "@napi-rs/canvas": "1.0.9",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-web": "1.30.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/chakra-petch": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
