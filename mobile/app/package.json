{
  "name": "toolbox-app",
  "private": true,
  "version": "0.35.0",
  "description": "ToolBox sur Android (be.toolbox.app) : coquille Capacitor, hôte téléphone dans un Worker, SQLite WebAssembly + OPFS (ADR 0044). React, Vite et le SDK viennent de la racine du dépôt.",
  "type": "module",
  "scripts": {
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "preview": "node ../../node_modules/vite/bin/vite.js preview --port 4180 --strictPort",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p ."
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
