{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@hub/sdk/*": ["./packages/sdk/*"]
    }
  },
  "include": [
    "electron",
    "backend",
    "frontend/src",
    "packages",
    "modules",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
