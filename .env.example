# ToolBox — variables d'environnement de DÉVELOPPEMENT (optionnelles).
# Copier ce fichier en `.env` (ignoré par Git) pour les surcharger.
# Aucun secret de l'utilisateur (identifiants OAuth, jetons) ne passe par ici :
# ils sont saisis dans la page Réglages de l'app et chiffrés avec safeStorage.

# Port fixe du backend en mode dev (en production, le port est aléatoire).
TOOLBOX_API_PORT=47321

# Port du serveur Vite en mode dev.
TOOLBOX_VITE_PORT=5173
